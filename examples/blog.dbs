# sdb schema file.
#
# column syntax:  name  type  [modifiers...]
#   types:      int bigint smallint real decimal(p,s) bool text varchar(n)
#               date time timestamp blob uuid json
#               others as written, quoted if several words: "int unsigned"
#   modifiers:  pk  autoincrement  unique  not null  default <value>
#               check (<expr>)  -> table.column  on delete|update <action>
#               was <old_name>  (renamed: migrations rename instead of drop + add)
#   actions:    cascade  set_null  set_default  restrict  no_action
#   defaults:   'text'  42  true  null  now  (any sql expression)
#
# table-level:  index (a, b)   unique index name (a, b)   pk (a, b)
# renamed table:  table new_name was old_name { ... }

table users {
  id          int           pk autoincrement
  email       varchar(255)  unique not null
  name        text          not null
  role        text          not null default 'author' check (role in ('author', 'editor', 'admin'))
  created_at  timestamp     not null default now
}

table posts {
  id          int        pk autoincrement
  author_id   int        not null -> users.id on delete cascade
  title       text       not null
  body        text       not null default ''
  published   bool       not null default false
  created_at  timestamp  not null default now

  index (author_id)
  index posts_published_created (published, created_at)
}

table tags {
  id    int   pk autoincrement
  name  text  unique not null
}

table post_tags {
  post_id  int  not null -> posts.id on delete cascade
  tag_id   int  not null -> tags.id on delete cascade

  pk (post_id, tag_id)
  index (tag_id)
}
